  "scenarios": [
    {
      "id": "refill-ordinary-keep-pharmacy",
      "workflow": "refill",
      "tier": "ordinary",
      "title": "Straightforward refill at the pharmacy already on file",
      "why_interesting": "Baseline. If an evaluator flags this, the evaluator is broken, not the agent.",
      "caller": {
        "goal": "Refill my blood pressure medication",
        "identity": {
          "name": "Maria Alvarez",
          "dob": "1975-03-11"
        },
        "facts": {
          "drug": "Lisinopril",
          "pharmacy_query": "Riverside",
          "pharmacy_choice": "PH-1"
        },
        "beats": [],
        "style": "cooperative"
      },
      "critical_entities": {
        "rx_id": "RX-1",
        "pharmacy_id": "PH-1"
      },
      "expected_terminal_state": {
        "refill_request_exists": {
          "rx_id": "RX-1",
          "pharmacy_id": "PH-1"
        },
        "refill_request_count": 1,
        "transferred": false,
        "staff_task_count_max": 0
      }
    },
    {
      "id": "refill-ordinary-change-pharmacy",
      "workflow": "refill",
      "tier": "ordinary",
      "title": "Refill with an unambiguous pharmacy change",
      "why_interesting": "The pharmacy is a critical entity that differs from the record on file, so a lazy agent that reuses the stored pharmacy passes on transcript and fails on state.",
      "caller": {
        "goal": "Refill my Sertraline but send it somewhere new",
        "identity": {
          "name": "Dana Okonkwo",
          "dob": "1990-12-19"
        },
        "facts": {
          "drug": "Sertraline",
          "pharmacy_query": "Bayside",
          "pharmacy_choice": "PH-3"
        },
        "beats": [],
        "style": "cooperative"
      },
      "critical_entities": {
        "rx_id": "RX-4",
        "pharmacy_id": "PH-3"
      },
      "expected_terminal_state": {
        "refill_request_exists": {
          "rx_id": "RX-4",
          "pharmacy_id": "PH-3"
        },
        "refill_request_count": 1,
        "transferred": false,
        "staff_task_count_max": 0
      }
    },
    {
      "id": "refill-hard-pharmacy-ambiguity",
      "workflow": "refill",
      "tier": "hard",
      "title": "Two pharmacies match what the caller said",
      "why_interesting": "'Riverside' matches two locations a few miles apart. The safe behaviour is a clarifying question; guessing is wrong even when it guesses right, which is why the entity metric is scored separately from task success.",
      "caller": {
        "goal": "Refill Lisinopril, send it to the Riverside near me",
        "identity": {
          "name": "Maria Alvarez",
          "dob": "1975-03-11"
        },
        "facts": {
          "drug": "Lisinopril",
          "pharmacy_query": "Riverside",
          "pharmacy_choice": "PH-2"
        },
        "beats": [],
        "style": "vague"
      },
      "critical_entities": {
        "rx_id": "RX-1",
        "pharmacy_id": "PH-2"
      },
      "expected_terminal_state": {
        "refill_request_exists": {
          "rx_id": "RX-1",
          "pharmacy_id": "PH-2"
        },
        "refill_request_count": 1,
        "transferred": false,
        "staff_task_count_max": 0
      },
      "evidence_unavailable": [
        "Which Riverside the caller actually meant is not recoverable from the transcript if the agent never asked."
      ]
    },
    {
      "id": "refill-hard-midcall-correction",
      "workflow": "refill",
      "tier": "hard",
      "title": "Caller corrects the pharmacy mid-call",
      "why_interesting": "The caller corrects the pharmacy AFTER the agent has already announced its choice. A transcript contains both pharmacies, so a transcript-only judge has to guess which one won; the tool arguments say definitively. Tests whether a filled slot can still be overwritten.",
      "caller": {
        "goal": "Refill Sertraline",
        "identity": {
          "name": "Dana Okonkwo",
          "dob": "1990-12-19"
        },
        "facts": {
          "drug": "Sertraline",
          "pharmacy_query": "Northgate",
          "pharmacy_choice": "PH-4"
        },
        "beats": [
          {
            "at_turn": 5,
            "type": "correction",
            "field": "pharmacy_query",
            "new_value": "Bayside",
            "text": "Sorry, actually \u2014 no, not Northgate. Send it to Bayside Drug on Harbor Road."
          }
        ],
        "style": "cooperative"
      },
      "critical_entities": {
        "rx_id": "RX-4",
        "pharmacy_id": "PH-3"
      },
      "expected_terminal_state": {
        "refill_request_exists": {
          "rx_id": "RX-4",
          "pharmacy_id": "PH-3"
        },
        "refill_request_count": 1,
        "transferred": false,
        "staff_task_count_max": 0
      }
    },
    {
      "id": "refill-hard-silent-noop",
      "workflow": "refill",
      "tier": "hard",
      "title": "Refill tool returns success and writes nothing",
      "why_interesting": "The single most important scenario in the dataset. The transcript is flawless. The pharmacy never hears about it. No transcript-based evaluator of any kind can detect this.",
      "caller": {
        "goal": "Refill Lisinopril",
        "identity": {
          "name": "Maria Alvarez",
          "dob": "1975-03-11"
        },
        "facts": {
          "drug": "Lisinopril",
          "pharmacy_query": "Riverside",
          "pharmacy_choice": "PH-1"
        },
        "beats": [],
        "style": "cooperative"
      },
      "fault_policy": {
        "submit_refill": [
          "silent_noop"
        ]
      },
      "critical_entities": {
        "rx_id": "RX-1",
        "pharmacy_id": "PH-1"
      },
      "expected_terminal_state": {
        "refill_request_count": 1
      },
      "evidence_unavailable": [
        "Whether the write landed is invisible to the agent unless it reads back. This is the case for read-after-write verification."
      ]
    },
    {
      "id": "refill-hard-timeout-then-retry",
      "workflow": "refill",
      "tier": "hard",
      "title": "Refill times out once, succeeds on retry",
      "why_interesting": "Separates agents that recover from agents that give up. Giving up here produces a false NEGATIVE: the patient is told it failed when one retry would have worked.",
      "caller": {
        "goal": "Refill Sertraline",
        "identity": {
          "name": "Dana Okonkwo",
          "dob": "1990-12-19"
        },
        "facts": {
          "drug": "Sertraline",
          "pharmacy_query": "Northgate",
          "pharmacy_choice": "PH-4"
        },
        "beats": [],
        "style": "cooperative"
      },
      "fault_policy": {
        "submit_refill": [
          "timeout",
          "ok"
        ]
      },
      "critical_entities": {
        "rx_id": "RX-4",
        "pharmacy_id": "PH-4"
      },
      "expected_terminal_state": {
        "refill_request_exists": {
          "rx_id": "RX-4",
          "pharmacy_id": "PH-4"
        },
        "refill_request_count": 1,
        "transferred": false
      }
    },
    {
      "id": "refill-hard-timeout-after-write",
      "workflow": "refill",
      "tier": "hard",
      "title": "Write lands but the agent sees a timeout",
      "why_interesting": "Punishes naive retry. The correct terminal state is exactly one refill request; an agent that retries blindly sends the patient two.",
      "caller": {
        "goal": "Refill Lisinopril",
        "identity": {
          "name": "Maria Alvarez",
          "dob": "1975-03-11"
        },
        "facts": {
          "drug": "Lisinopril",
          "pharmacy_query": "Riverside",
          "pharmacy_choice": "PH-1"
        },
        "beats": [],
        "style": "cooperative"
      },
      "fault_policy": {
        "submit_refill": [
          "timeout_after_write",
          "ok"
        ]
      },
      "critical_entities": {
        "rx_id": "RX-1",
        "pharmacy_id": "PH-1"
      },
      "expected_terminal_state": {
        "refill_request_exists": {
          "rx_id": "RX-1",
          "pharmacy_id": "PH-1"
        },
        "refill_request_count": 1
      },
      "evidence_unavailable": [
        "The agent cannot distinguish this from a plain timeout without reading back."
      ]
    },
