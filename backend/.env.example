# Copy to `backend/.env` and fill in ONE provider. `.env` is gitignored -- keep it that way.
#
#   cp .env.example .env
#
# The LLM judge replays from the committed cassette without any of this. You only
# need a key to RE-RECORD verdicts against a live model.

GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Opt in to live API calls. Without this, judge metrics replay from the cassette
# or report N/A -- so the test suite can never spend money.
KYRONEVAL_JUDGE=1

# Optional. Confirm a valid name first:
#   python -m kyroneval.evaluators.judge --list-models
# JUDGE_MODEL=openai/gpt-oss-120b
# JUDGE_PROVIDER=groq
