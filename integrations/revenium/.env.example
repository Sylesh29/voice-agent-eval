# Revenium: app.revenium.ai, API Keys page. Metering keys start with rev_mk_ (older ones hak_).
REVENIUM_METERING_API_KEY=
REVENIUM_METERING_BASE_URL=https://api.revenium.ai

# Provider keys: set the ones you have.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional attribution
REVENIUM_ENVIRONMENT=demo
REVENIUM_SUBSCRIBER_ID=sylesh
# REVENIUM_SUBSCRIBER_EMAIL=

# Which judges to compare, cheapest first, reference (most trusted) last
# JUDGE_MODELS=anthropic:claude-haiku-4-5,anthropic:claude-sonnet-4-5

# Optional stretch: client side enforcement (OpenAI calls only in SDK 0.10.x)
# REVENIUM_CIRCUIT_BREAKER_ENABLED=true
# REVENIUM_TEAM_ID=
# REVENIUM_ENFORCEMENT_BASE_URL=https://api.revenium.ai/profitstream
